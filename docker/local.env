# Local-only settings for docker-compose.local.yml.
# Contains NO production values: the local stack can never reach the live DB.
APP_NAME=Jfeid
APP_ENV=local
APP_KEY=base64:4yqtzdoVpvL6WIm++fMk0KMFVMRAmHLEYKX3VAFZO7w=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=jfeid_db
DB_USERNAME=jfeid_user
DB_PASSWORD=password
DB_SSLMODE=disable

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local

# Leave empty locally: notifications are logged, never sent to real phones.
FIREBASE_CREDENTIALS=
